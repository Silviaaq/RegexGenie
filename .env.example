# Copy to backend/.env; load with `set -a; . backend/.env; set +a`.
# Never commit actual credentials.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
GROQ_API_KEY=
# Select an available text model supporting JSON output in your Groq account.
GROQ_MODEL=
